let a = import! cast.authored.v1

let phases = {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"
install -Dm644 integration/device-broker.service "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/systemd/system/device-broker.service"
install -Dm644 integration/device-broker.sysusers "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/sysusers.d/device-broker.conf"
install -Dm644 integration/device-broker.tmpfiles "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/tmpfiles.d/device-broker.conf"
install -Dm644 integration/70-device-broker.rules "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/udev/rules.d/70-device-broker.rules"
install -Dm644 integration/io.example.DeviceBroker.rules "${CAST_INSTALL_ROOT}${CAST_DATADIR}/polkit-1/rules.d/io.example.DeviceBroker.rules"
"#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Device broker operating-system integration",
    description = a.optional.set "Service, identity, volatile-state, device-access, and authorization declarations for device-broker.",
    runtime_inputs = [
        a.dep.package "device-broker",
        a.dep.package "polkit",
        a.dep.package "systemd",
    ],
    paths = [
        a.path.any "/usr/lib/systemd/system/device-broker.service",
        a.path.any "/usr/lib/sysusers.d/device-broker.conf",
        a.path.any "/usr/lib/tmpfiles.d/device-broker.conf",
        a.path.any "/usr/lib/udev/rules.d/70-device-broker.rules",
        a.path.any "/usr/share/polkit-1/rules.d/io.example.DeviceBroker.rules",
    ],
    .. a.output "out"
}

{
    meta = {
        pname = "device-broker-integration",
        version = "1.4.0",
        release = 2,
        homepage = "https://example.invalid/device-broker",
        license = ["MPL-2.0"],
    },
    builder = a.builder.custom {
        required_tools = [a.dep.binary "install"],
        environment = [],
        phases = phases,
        supported_hooks = a.hook_support.all,
    },
    sources = [
        a.source.archive
            "https://example.invalid/device-broker-integration-1.4.0.tar.xz"
            "9abcdef0123456789abcdef0123456789abcdef0123456789abcdef012345678",
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [ root ],
    options = a.unset,
    profiles = [],
    architectures = ["native"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
