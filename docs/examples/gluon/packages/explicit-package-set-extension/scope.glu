let a = import! cast.authored.v1

let base = {
    shell = a.dep.package "bash",
    core = a.dep.package "coreutils",
}

// Extension is explicit, non-recursive, and receives the complete base set.
// There is no global package universe or reflection-based callPackage layer.
let with_observability = \packages ->
    {
        shell = packages.shell,
        core = packages.core,
        metrics = a.dep.package "prometheus-node-exporter",
        logs = a.dep.package "vector",
    }

{
    base,
    with_observability,
}
