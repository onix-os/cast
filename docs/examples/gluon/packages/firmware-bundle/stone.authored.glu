let a = import! cast.authored.v1

let phases = {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"
install -d "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/firmware/atlas"
install -m644 firmware/atlas-radio.bin firmware/atlas-dsp.bin "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/firmware/atlas/"
install -Dm644 firmware/atlas-radio.json "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/firmware/atlas/atlas-radio.json"
install -Dm644 LICENSE.firmware "${CAST_INSTALL_ROOT}${CAST_DATADIR}/licenses/atlas-firmware/LICENSE.firmware"
"#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Firmware and device metadata for Atlas radios",
    description = a.optional.set "Architecture-independent radio and DSP firmware with its machine-readable device manifest.",
    paths = [
        a.path.any "/usr/lib/firmware/atlas",
        a.path.any "/usr/share/licenses/atlas-firmware",
    ],
    .. a.output "out"
}

{
    meta = {
        pname = "atlas-firmware",
        version = "2026.06",
        release = 1,
        homepage = "https://example.invalid/atlas-firmware",
        license = ["LicenseRef-Atlas-Firmware"],
    },
    builder = a.builder.shell phases [a.dep.binary "install"],
    sources = [
        a.source.archive_with {
            url = "https://example.invalid/atlas-firmware-2026.06.tar.xz",
            hash = "89abcdef0123456789abcdef0123456789abcdef0123456789abcdef01234567",
            rename = a.optional.unset,
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "atlas-firmware",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["native"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
