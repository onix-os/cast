let arrays = import! std.array.prim
let a = import! cast.authored.v1
let policies = import! "./policies_authored.glu"

// Nix-style multi-output packaging is the inspiration, but this remains a
// Stone-native function: local output edges and external runtime capabilities
// are distinct typed values before Mason freezes them.
\inputs ->
    let package = a.package_ref inputs.pname

    let root = a.output_with {
        summary = a.optional.set "Telemetry service and configuration",
        runtime_inputs = [a.dep.output package "libs"],
        paths = [
            a.path.exe "/usr/bin/telemetry-agent",
            a.path.any "/usr/share/telemetry-runtime",
        ],
        .. a.output "out"
    }

    let libraries = a.output_with {
        summary = a.optional.set "Telemetry runtime libraries",
        paths = [a.path.any "/usr/lib/libtelemetry-runtime.so.*"],
        .. a.output "libs"
    }

    let development = a.output_with {
        summary = a.optional.set "Telemetry runtime development files",
        runtime_inputs = [a.dep.output package "libs"],
        paths = [
            a.path.any "/usr/include/telemetry-runtime",
            a.path.symlink "/usr/lib/libtelemetry-runtime.so",
            a.path.any "/usr/lib/pkgconfig/telemetry-runtime.pc",
        ],
        .. a.output "devel"
    }

    let tools = a.output_with {
        summary = a.optional.set "Telemetry diagnostics",
        runtime_inputs = arrays.append
            [a.dep.output package "libs"]
            inputs.policy.tools_runtime_inputs,
        paths = [a.path.exe "/usr/bin/telemetry-inspect"],
        .. a.output "tools"
    }

    let documentation = a.output_with {
        include_in_manifest = a.false,
        summary = a.optional.set "Telemetry API documentation",
        paths = [a.path.any "/usr/share/doc/telemetry-runtime"],
        .. a.output "docs"
    }

    arrays.append
        [root, libraries, development]
        (arrays.append
            (policies.when inputs.policy.tools [tools])
            (policies.when inputs.policy.documentation [documentation]))
