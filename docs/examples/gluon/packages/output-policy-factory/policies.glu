let a = import! cast.authored.v1

// `documentation`/`tools` are a small local Boolean, matching how
// `cast.package.v3` carries its own `boolean.when` selector: the flags never
// cross into the authored record directly, they only drive `when`-selection
// in the sibling authored helpers, so they stay this module's own type and
// `when` is exported alongside the policy data for those helpers to share.
type Boolean =
    | False
    | True

let when = \condition values ->
    match condition with
    | False -> []
    | True -> values

// This policy is ordinary typed Gluon data. The package factory uses it for
// the build while the output factory uses the same value for the published
// package graph, so those two declarations cannot silently choose different
// feature sets.
{
    when,
    edge_tools = {
        architectures = ["x86_64"],
        cmake_flags = [
            "-DBUILD_COMMAND_LINE_TOOLS=ON",
            "-DBUILD_DOCUMENTATION=OFF",
        ],
        documentation = False,
        tools = True,
        tools_runtime_inputs = [a.dep.package "ca-certificates"],
        tuning = [
            a.named "harden" a.tuning.enable,
            a.named "optimize" (a.tuning.config "size"),
        ],
    },
}
