let a = import! cast.authored.v1

let go = a.program.binary "go"

// The source archive contains go.mod, go.sum, and a complete vendor tree.
// Every Go invocation explicitly disables network-backed module resolution and
// keeps both writable caches inside the frozen build root.
let phases = a.scripts {
    setup = a.phase [
        a.step.run (a.program.binary "mkdir") ["-p", "build"],
        a.step.shell r#"test -f go.mod
test -f go.sum
test -d vendor"#,
    ],
    build = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [go],
            script = r#"export HOME="${CAST_BUILD_ROOT}/home"
export XDG_CONFIG_HOME="${CAST_BUILD_ROOT}/xdg-config"
export GOROOT=/usr/lib/golang
export GOCACHE="${CAST_BUILD_ROOT}/go-cache"
export GOMODCACHE="${CAST_BUILD_ROOT}/go-mod-cache"
export GOENV=off
export GOWORK=off
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GONOSUMDB='*'
export GONOPROXY=none
export GOFLAGS=
export GO111MODULE=on
export CGO_ENABLED=0
go telemetry off
go build -mod=vendor -trimpath -buildvcs=false -o build/glyph ./cmd/glyph"#,
        },
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm755 build/glyph "${CAST_INSTALL_ROOT}${CAST_BINDIR}/glyph"
install -Dm644 README.md "${CAST_INSTALL_ROOT}${CAST_DATADIR}/doc/go-glyph/README.md""#,
        },
    ],
    check = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [go],
            script = r#"export HOME="${CAST_BUILD_ROOT}/home"
export XDG_CONFIG_HOME="${CAST_BUILD_ROOT}/xdg-config"
export GOROOT=/usr/lib/golang
export GOCACHE="${CAST_BUILD_ROOT}/go-cache"
export GOMODCACHE="${CAST_BUILD_ROOT}/go-mod-cache"
export GOENV=off
export GOWORK=off
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GONOSUMDB='*'
export GONOPROXY=none
export GOFLAGS=
export GO111MODULE=on
export CGO_ENABLED=0
go telemetry off
go test -mod=vendor -trimpath ./..."#,
        },
    ],
    workload = a.phase [],
}

let root = {
    summary = a.optional.set "Offline-built glyph inspection tool",
    paths = [a.path.exe "/usr/bin/glyph"],
    .. a.output "out"
}

let docs = {
    include_in_manifest = a.boolean.false,
    summary = a.optional.set "Documentation for go-glyph",
    paths = [a.path.any "/usr/share/doc/go-glyph"],
    .. a.output "docs"
}

{
    meta = {
        pname = "go-glyph",
        version = "1.4.2",
        release = 1,
        homepage = "https://example.invalid/go-glyph",
        license = ["BSD-3-Clause"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mkdir",
        a.dep.binary "go",
        a.dep.binary "install",
    ],
    sources = [
        a.source.archive
            "https://example.invalid/go-glyph-1.4.2-vendored.tar.zst"
            "123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0",
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, docs],
    options = a.unset,
    profiles = [],
    architectures = ["native"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
