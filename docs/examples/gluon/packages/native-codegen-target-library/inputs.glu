let a = import! cast.authored.v1

let generator_package = a.package_ref "packet-schema-tools"
let generator_output = a.output_ref generator_package "compiler"

// Build-platform programs and target-platform libraries are different typed
// capabilities. The package factory does not discover either through PATH or
// the host filesystem.
{
    generator_dependency = a.dep.output generator_package "compiler",
    generator_program = a.program.output
        generator_output
        "/usr/libexec/packet-schema/packet-codegen",
    target_library = a.dep.pkgconfig "packet-runtime",
    target_runtime = a.dep.soname "libpacket-runtime.so.1",
}
