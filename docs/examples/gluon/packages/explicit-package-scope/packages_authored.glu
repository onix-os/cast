let a = import! cast.authored.v1

let client = \scope ->
    {
        meta = {
            pname = "scoped-client",
            version = "1.2.0",
            release = 1,
            homepage = "https://example.invalid/scoped-client",
            license = ["BSD-2-Clause"],
        },
        builder = a.builder.cmake { flags = ["-DBUILD_SERVER=OFF"], run_tests = a.true },
        sources = [
            a.source.archive
                "https://example.invalid/scoped-client-1.2.0.tar.xz"
                "5555555555555555555555555555555555555555555555555555555555555555",
        ],
        native_build_inputs = [],
        build_inputs = [scope.compression, scope.crypto],
        check_inputs = [],
        outputs = a.outputs.default,
        options = a.unset,
        profiles = [],
        architectures = ["native"],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }

let server = \scope ->
    {
        meta = {
            pname = "scoped-server",
            version = "1.2.0",
            release = 1,
            homepage = "https://example.invalid/scoped-server",
            license = ["BSD-2-Clause"],
        },
        builder = a.builder.cmake { flags = ["-DBUILD_SERVER=ON"], run_tests = a.true },
        sources = [
            a.source.archive
                "https://example.invalid/scoped-server-1.2.0.tar.xz"
                "6666666666666666666666666666666666666666666666666666666666666666",
        ],
        native_build_inputs = [scope.documentation],
        build_inputs = [scope.database],
        check_inputs = [],
        outputs = a.outputs.default,
        options = a.unset,
        profiles = [],
        architectures = ["native"],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }

{
    client,
    server,
}
