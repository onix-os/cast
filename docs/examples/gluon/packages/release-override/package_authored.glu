let a = import! cast.authored.v1

// The authored base package. In the authored form a "base" is just a package
// record other recipes update with `{ field = .., .. base }`; there is no patch
// ADT or `override_attrs` merge — Gluon record update is the override mechanism.
{
    meta = {
        pname = "override-release",
        version = "1.0.0",
        release = 1,
        homepage = "https://example.invalid/override-release",
        license = ["MIT"],
    },
    builder = a.builder.cmake { flags = [], run_tests = a.true },
    sources = [
        a.source.archive_with {
            url = "https://example.invalid/override-release-1.0.0.tar.xz",
            hash = "3333333333333333333333333333333333333333333333333333333333333333",
            rename = a.optional.set "override-release-1.0.0.tar.xz",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "override-release-1.0.0",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.default,
    options = a.unset,
    profiles = [],
    architectures = ["native"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
