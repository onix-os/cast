let a = import! cast.authored.v1

let pname = "split-demo"

let root = {
    summary = a.optional.set "Command-line tools",
    paths = [
        a.path.exe "/usr/bin/split-demo",
        a.path.any "/usr/share/man/man1",
    ],
    .. a.output "out"
}

let libraries = {
    summary = a.optional.set "Runtime libraries",
    paths = [a.path.any "/usr/lib/libsplit-demo.so.*"],
    .. a.output "libs"
}

let development = {
    summary = a.optional.set "Headers and link-time files",
    runtime_inputs = [a.dep.output (a.package_ref pname) "libs"],
    paths = [
        a.path.any "/usr/include/split-demo",
        a.path.any "/usr/lib/libsplit-demo.so",
        a.path.any "/usr/lib/pkgconfig/split-demo.pc",
    ],
    .. a.output "devel"
}

let documentation = {
    include_in_manifest = a.false,
    summary = a.optional.set "Reference documentation",
    paths = [a.path.any "/usr/share/doc/split-demo"],
    .. a.output "docs"
}

{
    meta = {
        pname,
        version = "4.0.2",
        release = 1,
        homepage = "https://example.invalid/split-demo",
        license = ["LGPL-2.1-or-later"],
    },
    builder = a.builder.cmake { flags = [], run_tests = a.true },
    sources = [
        a.source.archive
            "https://example.invalid/split-demo-4.0.2.tar.xz"
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, libraries, development, documentation],
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
