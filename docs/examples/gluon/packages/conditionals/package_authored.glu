
let a = import! cast.authored.v1
let { Bool } = import! cast.authored.v1

// `Bool` is destructured from the authored prelude so its `True`/`False`
// constructors are in scope for plain `if`/`then`/`else`, matching the type
// used by `features.documentation` / `features.tests` / `features.tls`.
let when = \condition values ->
    if condition then values else []

\features ->
    {
        meta = {
            pname = "conditional-viewer",
            version = "1.5.0",
            release = 1,
            homepage = "https://example.invalid/conditional-viewer",
            license = ["MIT"],
        },
        builder = a.builder.cmake {
            flags = when features.documentation ["-DBUILD_DOCUMENTATION=ON"],
            run_tests = features.tests,
        },
        sources = [
            a.source.archive
                "https://example.invalid/conditional-viewer-1.5.0.tar.xz"
                "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        ],
        native_build_inputs = [],
        build_inputs = when features.tls [a.dep.pkgconfig "openssl"],
        check_inputs = when features.tests [a.dep.binary "xvfb-run"],
        outputs = a.outputs.default,
        options = a.unset,
        profiles = [],
        architectures = [],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }
