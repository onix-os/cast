let a = import! cast.authored.v1
let patch_series = import! "./patches_authored.glu"
let sources = import! "./sources_authored.glu"

{
    meta = {
        pname = "portable-check",
        version = "4.0.0",
        release = 2,
        homepage = "https://example.invalid/portable-check",
        license = ["MIT"],
    },
    builder = a.builder.cmake {
        flags = ["-DUSE_SYSTEM_LIBRARIES=ON"],
        run_tests = a.true,
    },
    sources = sources,
    native_build_inputs = [a.dep.binary "patch"],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.default,
    options = a.unset,
    profiles = [],
    architectures = ["x86_64", "aarch64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.some.hooks (a.hooks {
        pre_setup = patch_series,
        .. a.empty.hooks
    }),
}
