let a = import! cast.authored.v1

// A prebuilt upstream archive still has a fully declared install phase. The
// target restriction, archive layout, installed paths, and required installer
// are data in the package rather than assumptions made by a build script.
let phases = {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"
install -Dm755 bin/orbit "${CAST_INSTALL_ROOT}${CAST_BINDIR}/orbit"
install -Dm644 share/man/man1/orbit.1 "${CAST_INSTALL_ROOT}${CAST_DATADIR}/man/man1/orbit.1"
"#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Orbit artifact inspector",
    paths = [
        a.path.exe "/usr/bin/orbit",
        a.path.any "/usr/share/man/man1/orbit.1",
    ],
    .. a.output "out"
}

{
    meta = {
        pname = "orbit-bin",
        version = "4.6.2",
        release = 1,
        homepage = "https://example.invalid/orbit",
        license = ["Apache-2.0"],
    },
    builder = a.builder.custom {
        required_tools = [a.dep.binary "install"],
        environment = [],
        phases,
        supported_hooks = a.hook_support.all,
    },
    sources = [
        a.source.archive_with {
            url = "https://example.invalid/orbit-4.6.2-x86_64.tar.xz",
            hash = "123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0",
            rename = a.optional.unset,
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "prebuilt",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
