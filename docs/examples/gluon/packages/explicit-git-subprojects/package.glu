let a = import! cast.authored.v1

\repositories ->
    let hooks = a.hooks {
        pre_setup = [
            a.step.run
                (a.program.binary "mkdir")
                ["-p", "application/subprojects"],
            a.step.run
                (a.program.binary "ln")
                ["-s", "../../syntax-engine", "application/subprojects/syntax-engine"],
            a.step.run
                (a.program.binary "ln")
                ["-s", "../../wire-format", "application/subprojects/wire-format"],
        ],
        .. a.empty.hooks
    }

    {
        meta = {
            pname = "orbit-console",
            version = "2.4.0",
            release = 1,
            homepage = "https://example.invalid/orbit-console",
            license = ["BSD-2-Clause"],
        },
        builder = a.builder.cmake {
            flags = [
                "-Sapplication",
                "-DFETCHCONTENT_FULLY_DISCONNECTED=ON",
                "-DUSE_BUNDLED_SUBPROJECTS=ON",
            ],
            run_tests = a.true,
        },
        sources = [
            repositories.application,
            repositories.syntax,
            repositories.protocol,
        ],
        native_build_inputs = [],
        build_inputs = [],
        check_inputs = [],
        outputs = a.outputs.default,
        options = a.unset,
        profiles = [],
        architectures = ["native"],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.some.hooks hooks,
    }
