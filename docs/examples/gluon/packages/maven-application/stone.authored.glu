let a = import! cast.authored.v1

let maven = a.program.binary "mvn"

// The source archive carries the complete Maven repository selected by the
// dependency lock. `--offline` and the explicit repository path make a missing
// artifact a build failure instead of a network fetch.
let phases = {
    setup = a.phase [
        a.step.shell r#"test -f pom.xml
test -f dependencies.lock
test -d vendor/m2"#,
    ],
    build = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [maven],
            script = r#"mvn --offline --batch-mode --no-transfer-progress \
    -Dmaven.repo.local="${CAST_SOURCE_DIR}/vendor/m2" \
    -Dproject.build.outputTimestamp="${SOURCE_DATE_EPOCH}" \
    -DskipTests package"#,
        },
    ],
    check = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [maven],
            script = r#"mvn --offline --batch-mode --no-transfer-progress \
    -Dmaven.repo.local="${CAST_SOURCE_DIR}/vendor/m2" \
    -Dproject.build.outputTimestamp="${SOURCE_DATE_EPOCH}" \
    test"#,
        },
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm644 target/pulse-router.jar "${CAST_INSTALL_ROOT}${CAST_DATADIR}/java/pulse-router/pulse-router.jar"
install -Dm755 packaging/pulse-router "${CAST_INSTALL_ROOT}${CAST_BINDIR}/pulse-router""#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Pulse routing service built from a locked Maven repository",
    runtime_inputs = [a.dep.binary "java"],
    paths = [
        a.path.exe "/usr/bin/pulse-router",
        a.path.any "/usr/share/java/pulse-router/pulse-router.jar",
    ],
    .. a.output "out"
}

{
    meta = {
        pname = "pulse-router",
        version = "7.2.0",
        release = 1,
        homepage = "https://example.invalid/pulse-router",
        license = ["Apache-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mvn",
        a.dep.binary "install",
    ],
    sources = [
        a.source.archive
            "https://example.invalid/pulse-router-7.2.0-vendored.tar.xz"
            "6789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012345",
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["native"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
