let a = import! cast.authored.v1
let family = import! "./family_authored.glu"

\release member ->
    let selected = family.select member
    {
        meta = {
            pname = selected.pname,
            version = release.version,
            release = release.package_release,
            homepage = "https://example.invalid/relay-family",
            license = ["Apache-2.0"],
        },
        builder = a.builder.cmake { flags = [selected.flag], run_tests = a.true },
        sources = [a.source.archive release.source_url release.source_sha256],
        native_build_inputs = [],
        build_inputs = [],
        check_inputs = [],
        outputs = a.outputs.explicit [
            {
                summary = a.optional.set selected.summary,
                runtime_inputs = selected.runtime_inputs,
                paths = selected.paths,
                .. a.output "out"
            },
        ],
        options = a.unset,
        profiles = [],
        architectures = ["x86_64", "aarch64"],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }
