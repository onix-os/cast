let a = import! cast.authored.v1
let dependencies = import! "./dependencies_authored.glu"
let make_outputs = import! "./outputs_authored.glu"
let make_package = import! "./package_authored.glu"

// A package-level dependency would reach every output. Passing this exact
// named development output into the output factory keeps it on `devel` only.
make_package {
    dependencies,
    output_factory = make_outputs,
}
