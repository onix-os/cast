let a = import! cast.authored.v1

// Output closure is declared per output. In particular, headers and link-time
// metadata need both this package's libraries and the external development
// interface; neither dependency is implicitly propagated to sibling outputs.
\inputs ->
    let package = a.package_ref inputs.pname

    let root = a.output_with {
        summary = a.optional.set "Interface closure metadata",
        paths = [a.path.any "/usr/share/interface-closure"],
        .. a.output "out"
    }

    let libraries = a.output_with {
        summary = a.optional.set "Interface closure runtime library",
        paths = [a.path.any "/usr/lib/libinterface-closure.so.*"],
        .. a.output "libs"
    }

    let development = a.output_with {
        summary = a.optional.set "Interface closure development files",
        runtime_inputs = [
            a.dep.output package "libs",
            inputs.dependencies.external_development,
        ],
        paths = [
            a.path.any "/usr/include/interface-closure",
            a.path.symlink "/usr/lib/libinterface-closure.so",
            a.path.any "/usr/lib/pkgconfig/interface-closure.pc",
        ],
        .. a.output "devel"
    }

    [root, libraries, development]
