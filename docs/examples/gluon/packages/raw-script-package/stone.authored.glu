let a = import! cast.authored.v1

let phases = a.scripts {
    check = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "sh",
            declared_programs = [a.program.binary "bash"],
            script = r#"bash -n "${CAST_SOURCE_DIR}/net-audit""#,
        },
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm755 "${CAST_SOURCE_DIR}/net-audit" "${CAST_INSTALL_ROOT}${CAST_BINDIR}/net-audit""#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Small network-audit command",
    runtime_inputs = [a.dep.binary "bash"],
    paths = [a.path.exe "/usr/bin/net-audit"],
    .. a.output "out"
}

{
    meta = {
        pname = "net-audit",
        version = "3.1.0",
        release = 1,
        homepage = "https://example.invalid/net-audit",
        license = ["ISC"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "sh",
        a.dep.binary "bash",
        a.dep.binary "install",
    ],
    sources = [
        // A single fetched file is locked and renamed but never interpreted as
        // an archive. Frozen preparation therefore has no extraction step.
        a.source.archive_with {
            url = "https://example.invalid/releases/net-audit-3.1.0",
            hash = "789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456",
            rename = a.optional.set "net-audit",
            strip_dirs = a.optional.unset,
            unpack = a.false,
            unpack_dir = a.optional.unset,
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["native"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
