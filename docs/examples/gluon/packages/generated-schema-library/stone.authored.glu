let a = import! cast.authored.v1

let pname = "wire-schema-runtime"
let schema_tools = a.output_ref (a.package_ref "wire-schema") "compiler"

let phases = {
    setup = a.phase [
        a.step.run (a.program.binary "mkdir") ["-p", "build"],
    ],
    build = a.phase [
        // The code generator is tied to one named output rather than found
        // through an ambient PATH or an arbitrary provider.
        a.step.run
            (a.program.output schema_tools "/usr/libexec/wire-schema/wire-codegen")
            [
                "--language",
                "c",
                "--input",
                "protocol/wire.schema",
                "--header",
                "build/wire-schema.h",
                "--source",
                "build/wire-schema.c",
            ],
        a.step.run
            (a.program.binary "cc")
            ["-fPIC", "-O2", "-c", "build/wire-schema.c", "-o", "build/wire-schema.o"],
        a.step.run
            (a.program.binary "cc")
            [
                "-shared",
                "-Wl,-soname,libwire-schema.so.2",
                "build/wire-schema.o",
                "-o",
                "build/libwire-schema.so.2.0.0",
            ],
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [
                a.program.binary "install",
                a.program.binary "ln",
            ],
            script = r#"
install -Dm644 protocol/wire.schema "${CAST_INSTALL_ROOT}${CAST_DATADIR}/wire-schema/wire.schema"
install -Dm755 build/libwire-schema.so.2.0.0 "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/libwire-schema.so.2.0.0"
ln -s libwire-schema.so.2.0.0 "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/libwire-schema.so.2"
ln -s libwire-schema.so.2 "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/libwire-schema.so"
install -Dm644 build/wire-schema.h "${CAST_INSTALL_ROOT}${CAST_PREFIX}/include/wire-schema/wire-schema.h"
"#,
        },
    ],
    check = a.phase [
        a.step.run (a.program.binary "test") ["-s", "build/wire-schema.c"],
        a.step.run (a.program.binary "test") ["-s", "build/wire-schema.h"],
    ],
    workload = a.empty.scripts.workload,
}

let root = {
    summary = a.optional.set "Wire protocol schema data",
    paths = [a.path.any "/usr/share/wire-schema"],
    .. a.output "out"
}

let libraries = {
    summary = a.optional.set "Generated wire schema runtime library",
    paths = [a.path.any "/usr/lib/libwire-schema.so.*"],
    .. a.output "libs"
}

let development = {
    summary = a.optional.set "Generated wire schema C interface",
    runtime_inputs = [a.dep.output (a.package_ref pname) "libs"],
    paths = [
        a.path.any "/usr/include/wire-schema",
        a.path.symlink "/usr/lib/libwire-schema.so",
    ],
    .. a.output "devel"
}

{
    meta = {
        pname,
        version = "2.0.0",
        release = 1,
        homepage = "https://example.invalid/wire-schema",
        license = ["Apache-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mkdir",
        a.dep.output (a.package_ref "wire-schema") "compiler",
        a.dep.binary "cc",
        a.dep.binary "install",
        a.dep.binary "ln",
        a.dep.binary "test",
    ],
    sources = [
        a.source.archive
            "https://example.invalid/wire-schema-runtime-2.0.0.tar.xz"
            "789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456",
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, libraries, development],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64", "aarch64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
