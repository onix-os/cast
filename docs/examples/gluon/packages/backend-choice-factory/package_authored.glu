let a = import! cast.authored.v1

type Backend =
    | OpenSsl
    | LibreSsl
    | Rustls

let select = \backend ->
    match backend with
    | OpenSsl -> {
        flag = "-DTLS_BACKEND=openssl",
        development = a.dep.pkgconfig "openssl",
        runtime = a.dep.soname "libssl.so.3",
    }
    | LibreSsl -> {
        flag = "-DTLS_BACKEND=libressl",
        development = a.dep.pkgconfig "libressl",
        runtime = a.dep.soname "libtls.so.28",
    }
    | Rustls -> {
        flag = "-DTLS_BACKEND=rustls",
        development = a.dep.pkgconfig "rustls-ffi",
        runtime = a.dep.soname "librustls_ffi.so.0",
    }

let make = \backend ->
    let selected = select backend

    {
        meta = {
            pname = "typed-backend-client",
            version = "4.0.0",
            release = 1,
            homepage = "https://example.invalid/typed-backend-client",
            license = ["MPL-2.0"],
        },
        builder = a.builder.cmake { flags = [selected.flag], run_tests = a.true },
        sources = [
            a.source.archive
                "https://example.invalid/typed-backend-client-4.0.0.tar.xz"
                "456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123",
        ],
        native_build_inputs = [],
        build_inputs = [selected.development],
        check_inputs = [],
        outputs = a.outputs.explicit [
            {
                runtime_inputs = [selected.runtime],
                paths = [a.path.any "*"],
                .. a.output "out"
            },
        ],
        options = a.unset,
        profiles = [],
        architectures = ["native"],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }

{
    make,
    openssl = OpenSsl,
    libressl = LibreSsl,
    rustls = Rustls,
}
