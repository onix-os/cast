let a = import! cast.authored.v1
let matrix = import! "./matrix_authored.glu"

\storage telemetry ->
    let selected = matrix.select storage telemetry
    {
        meta = {
            pname = "matrix-service",
            version = "2.0.0",
            release = 1,
            homepage = "https://example.invalid/matrix-service",
            license = ["MPL-2.0"],
        },
        builder = a.builder.cmake {
            flags = selected.flags,
            run_tests = a.true,
        },
        sources = [
            a.source.archive
                "https://example.invalid/matrix-service-2.0.0.tar.xz"
                "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
        ],
        native_build_inputs = [],
        build_inputs = selected.build_inputs,
        check_inputs = [],
        outputs = a.outputs.explicit [
            {
                runtime_inputs = selected.runtime_inputs,
                paths = [a.path.any "*"],
                .. a.output "out"
            },
        ],
        options = a.unset,
        profiles = [],
        architectures = ["native"],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }
