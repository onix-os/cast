
let a = import! cast.authored.v1

// Patch order is an evaluated Gluon value shared with the package root. Each
// element remains a typed program invocation rather than an opaque macro.
[
    a.step.run (a.program.binary "patch") ["-p1", "-i", "packaging/0001-reproducible-build.patch"],
    a.step.run (a.program.binary "patch") ["-p1", "-i", "packaging/0002-usr-layout.patch"],
    a.step.run (a.program.binary "patch") ["-p1", "-i", "packaging/0003-offline-tests.patch"],
]
