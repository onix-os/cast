let a = import! cast.authored.v1

let phases = {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm755 bin/orbit-monitor "${CAST_INSTALL_ROOT}${CAST_BINDIR}/orbit-monitor""#,
        },
    ],
    .. a.empty.scripts
}

// The selected record fixes the target, source bytes, and runtime loader as
// one pure input. Both platform records have the same type and can be chosen by
// another root without changing this factory.
\platform ->
    let root = {
        summary = a.optional.set "Prebuilt Orbit system monitor",
        runtime_inputs = [a.dep.interpreter platform.interpreter_path],
        paths = [a.path.exe "/usr/bin/orbit-monitor"],
        .. a.output "out"
    }

    {
        meta = {
            pname = "orbit-monitor-bin",
            version = "5.1.0",
            release = 1,
            homepage = "https://example.invalid/orbit-monitor",
            license = ["Apache-2.0"],
        },
        builder = a.builder.shell phases [a.dep.binary "install"],
        sources = [
            a.source.archive_with {
                url = platform.url,
                hash = platform.sha256,
                rename = a.optional.set platform.archive,
                strip_dirs = a.optional.set 1,
                unpack = a.true,
                unpack_dir = a.optional.set "orbit-monitor",
            },
        ],
        native_build_inputs = [],
        build_inputs = [],
        check_inputs = [],
        outputs = a.outputs.explicit [root],
        options = a.unset,
        profiles = [],
        architectures = [platform.architecture],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }
