let a = import! cast.authored.v1
let { Bool } = a

// Per-profile builders carry the fully lowered `BuilderSpec` (not a
// `BuilderRequest`): `ProfileSpec` is passed through `lower` untouched, so the
// same cmake-builder expansion that `cast.builders.cmake.v2` performs in the
// legacy world has to be authored by hand here.
let cmake_profile_builder = \flags run_tests ->
    let check_steps =
        match run_tests with
        | True -> [a.step.cmake_test]
        | False -> []
    {
        required_tools = [a.dep.binary "sh", a.dep.binary "ninja"],
        environment = [a.environment.cmake],
        phases = {
            setup = a.phase [a.step.cmake_configure flags],
            build = a.phase [a.step.cmake_build],
            install = a.phase [a.step.cmake_install],
            check = a.phase check_steps,
            workload = a.phase [],
        },
        supported_hooks = a.hook_support.all,
    }

let emul32_profile = {
    name = "emul32",
    builder = cmake_profile_builder
        [
            "-DCMAKE_INSTALL_LIBDIR=lib32",
            "-DENABLE_TOOLS=OFF",
        ]
        True,
    hooks = a.empty.hooks,
    native_build_inputs = [a.dep.binary "nasm"],
    build_inputs = [a.dep.pkgconfig32 "zlib"],
    check_inputs = [a.dep.binary "file"],
}

let v3_profile = {
    name = "x86_64-v3x",
    builder = cmake_profile_builder ["-DENABLE_DISPATCH=ON"] True,
    hooks = a.empty.hooks,
    native_build_inputs = [],
    build_inputs = [a.dep.pkgconfig "zlib"],
    check_inputs = [],
}

{
    meta = {
        pname = "profiled-codec",
        version = "7.1.4",
        release = 3,
        homepage = "https://example.invalid/profiled-codec",
        license = ["BSD-3-Clause"],
    },
    builder = a.builder.cmake { flags = [], run_tests = a.true },
    sources = [
        a.source.archive
            "https://example.invalid/profiled-codec-7.1.4.tar.xz"
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    ],
    native_build_inputs = [],
    build_inputs = [a.dep.pkgconfig "zlib"],
    check_inputs = [],
    outputs = a.outputs.default,
    options = a.unset,
    profiles = [emul32_profile, v3_profile],
    architectures = ["native", "emul32"],
    tuning = [],
    emul32 = a.true,
    mold = a.false,
    hooks = a.unset,
}
