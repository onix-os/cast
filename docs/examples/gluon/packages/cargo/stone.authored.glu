let a = import! cast.authored.v1

// The structural Cargo builder deliberately has no fetch step. A real
// dependency-bearing source archive must include a locked vendor tree and
// Cargo source replacement configuration before the isolated build begins.
{
    meta = {
        pname = "cargo-hello",
        version = "0.9.3",
        release = 1,
        homepage = "https://example.invalid/cargo-hello",
        license = ["Apache-2.0", "MIT"],
    },
    builder = a.builder.cargo {
        features = ["pcre2", "unicode"],
        binaries = ["cargo-hello"],
        run_tests = a.true,
    },
    sources = [
        a.source.archive
            "https://example.invalid/cargo-hello-0.9.3.tar.gz"
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    ],
    native_build_inputs = [],
    build_inputs = [a.dep.pkgconfig "libpcre2-8"],
    check_inputs = [],
    outputs = a.outputs.default,
    options = a.unset,
    profiles = [],
    architectures = ["native"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
