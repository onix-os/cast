let a = import! cast.authored.v1

let pname = "northstar-agent"

let root_output = {
    summary = a.optional.set "Northstar system telemetry agent",
    description = a.optional.set "Daemon, command-line client, service unit, and default configuration.",
    runtime_inputs = [
        a.dep.system_binary "useradd",
        a.dep.soname "libssl.so.3",
    ],
    paths = [
        a.path.exe "/usr/bin/northstarctl",
        a.path.exe "/usr/sbin/northstar-agent",
        a.path.any "/usr/lib/systemd/system/northstar-agent.service",
        a.path.any "/usr/share/defaults/northstar-agent",
    ],
    conflicts = [a.dep.package "northstar-agent-legacy"],
    .. a.output "out"
}

let library_output = {
    summary = a.optional.set "Northstar client runtime library",
    paths = [a.path.any "/usr/lib/libnorthstar.so.*"],
    .. a.output "libs"
}

let development_output = {
    summary = a.optional.set "Northstar client development files",
    runtime_inputs = [a.dep.output (a.package_ref pname) "libs"],
    paths = [
        a.path.any "/usr/include/northstar",
        a.path.any "/usr/lib/libnorthstar.so",
        a.path.any "/usr/lib/cmake/Northstar",
        a.path.any "/usr/lib/pkgconfig/northstar.pc",
    ],
    .. a.output "devel"
}

let documentation_output = {
    include_in_manifest = a.false,
    summary = a.optional.set "Northstar operator documentation",
    paths = [
        a.path.any "/usr/share/doc/northstar-agent",
        a.path.any "/usr/share/man/man5/northstar-agent.conf.5",
        a.path.any "/usr/share/man/man8/northstar-agent.8",
    ],
    .. a.output "docs"
}

{
    meta = {
        pname,
        version = "12.4.0",
        release = 4,
        homepage = "https://example.invalid/northstar-agent",
        license = ["Apache-2.0"],
    },
    builder = a.builder.cmake {
        flags = [
            "-DBUILD_SHARED_LIBS=ON",
            "-DENABLE_CLIENT=ON",
            "-DENABLE_DAEMON=ON",
            "-DENABLE_SYSTEMD=ON",
            "-DUSE_BUNDLED_PROTOBUF=OFF",
        ],
        run_tests = a.true,
    },
    sources = [
        a.source.archive_with {
            url = "https://example.invalid/northstar-agent-12.4.0.tar.xz",
            hash = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            rename = a.optional.unset,
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "northstar-agent",
        },
        a.source.archive_with {
            url = "https://example.invalid/northstar-protocol-2026-04.dat",
            hash = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
            rename = a.optional.set "northstar-protocol.dat",
            strip_dirs = a.optional.unset,
            unpack = a.false,
            unpack_dir = a.optional.unset,
        },
    ],
    native_build_inputs = [
        a.dep.binary "patch",
        a.dep.binary "pkgconf",
        a.dep.binary "protoc",
    ],
    build_inputs = [
        a.dep.cmake "Protobuf",
        a.dep.pkgconfig "libsystemd",
        a.dep.pkgconfig "openssl",
        a.dep.pkgconfig "zlib",
    ],
    check_inputs = [
        a.dep.binary "dbus-run-session",
        a.dep.binary "jq",
    ],
    outputs = a.outputs.explicit [
        root_output,
        library_output,
        development_output,
        documentation_output,
    ],
    options = a.some.options (a.options {
        toolchain = a.toolchain.llvm,
        cspgo = a.false,
        samplepgo = a.false,
        debug = a.false,
        strip = a.true,
        networking = a.false,
        compressman = a.true,
        lastrip = a.true,
    }),
    profiles = [],
    architectures = ["x86_64", "aarch64"],
    tuning = [
        a.named "harden" a.tuning.enable,
        a.named "lto" (a.tuning.config "thin"),
        a.named "optimize" (a.tuning.config "speed"),
    ],
    emul32 = a.false,
    mold = a.true,
    hooks = a.some.hooks (a.hooks {
        pre_setup = [
            a.step.run (a.program.binary "patch") ["-p1", "-i", "packaging/reproducible-build.patch"],
        ],
        post_setup = [],
        pre_build = [],
        post_build = [],
        pre_check = [
            a.step.shell r#"test -d "${CAST_BUILDER_DIR}"
test -f "${CAST_BUILDER_DIR}/CMakeCache.txt""#,
        ],
        post_check = [],
        pre_install = [],
        post_install = [
            a.step.shell_with {
                interpreter = a.program.binary "bash",
                declared_programs = [
                    a.program.binary "install",
                    a.program.binary "ln",
                ],
                script = r#"
install -Dm644 packaging/northstar-agent.service "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/systemd/system/northstar-agent.service"
install -Dm644 packaging/northstar-agent.conf "${CAST_INSTALL_ROOT}${CAST_DATADIR}/defaults/northstar-agent/northstar-agent.conf"
ln -s northstarctl "${CAST_INSTALL_ROOT}${CAST_BINDIR}/northstar"
"#,
            },
        ],
        pre_workload = [],
        post_workload = [],
    }),
}
