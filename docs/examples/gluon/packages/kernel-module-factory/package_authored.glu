let strings = import! std.string.prim
let a = import! cast.authored.v1

// Specializing this pure factory with another kernel record changes the
// dependency closure, build arguments, installed module path, and targets as
// one value. Nothing consults `uname` or an ambient /lib/modules directory.
\kernel ->
    let make = a.program.binary "make"
    let release_arg = strings.append "KERNEL_RELEASE=" kernel.release
    let build_tree_arg = strings.append "KERNEL_DIR=" kernel.build_tree
    let module_root = strings.append "/usr/lib/modules/" kernel.release
    let module_path = strings.append module_root "/extra/atlas-sensor.ko"

    let phases = a.scripts {
        build = a.phase [
            a.step.run make [release_arg, build_tree_arg, "modules"],
        ],
        check = a.phase [
            a.step.run (a.program.binary "modinfo") ["build/atlas-sensor.ko"],
        ],
        install = a.phase [
            a.step.run
                (a.program.binary "bash")
                ["packaging/install-module", kernel.release],
        ],
        .. a.empty.scripts
    }

    let root = a.output_with {
        summary = a.optional.set "Atlas sensor module for the selected LTS kernel",
        runtime_inputs = [a.dep.output kernel.package "out"],
        paths = [a.path.any module_path],
        .. a.output "out"
    }

    let base = {
        meta = {
            pname = "atlas-sensor-module",
            version = "2.3.1",
            release = 1,
            homepage = "https://example.invalid/atlas-sensor",
            license = ["GPL-2.0-only"],
        },
        builder = a.builder.custom a.empty.builder,
        sources = [],
        native_build_inputs = [],
        build_inputs = [],
        check_inputs = [],
        outputs = a.outputs.default,
        options = a.unset,
        profiles = [],
        architectures = [],
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }

    {
        builder = a.builder.custom {
            required_tools = [
                a.dep.binary "make",
                a.dep.binary "modinfo",
                a.dep.binary "bash",
                a.dep.binary "install",
            ],
            environment = [],
            phases,
            supported_hooks = a.hook_support.all,
        },
        native_build_inputs = [kernel.headers],
        outputs = a.outputs.explicit [root],
        sources = [
            a.source.archive
                "https://example.invalid/atlas-sensor-module-2.3.1.tar.xz"
                "456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123",
        ],
        architectures = kernel.architectures,
        .. base
    }
