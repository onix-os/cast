let a = import! cast.authored.v1

let pname = "vector-math"

// This builder spells out preprocessing, compilation, linking, validation,
// and installation. No implicit build-system probe decides which tools run.
let phases = a.scripts {
    setup = a.phase [
        a.step.run (a.program.binary "mkdir") ["-p", "build"],
    ],
    build = a.phase [
        a.step.run
            (a.program.binary "cc")
            ["-E", "-I", "include", "src/vector.c", "-o", "build/vector.i"],
        a.step.run
            (a.program.binary "cc")
            ["-fPIC", "-O2", "-c", "build/vector.i", "-o", "build/vector.o"],
        a.step.run
            (a.program.binary "cc")
            [
                "-shared",
                "-Wl,-soname,libvector-math.so.1",
                "build/vector.o",
                "-o",
                "build/libvector-math.so.1.0.0",
            ],
        a.step.run
            (a.program.binary "cc")
            [
                "-I",
                "include",
                "tools/vector-calc.c",
                "build/libvector-math.so.1.0.0",
                "-o",
                "build/vector-calc",
            ],
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [
                a.program.binary "install",
                a.program.binary "ln",
            ],
            script = r#"
install -Dm755 build/vector-calc "${CAST_INSTALL_ROOT}${CAST_BINDIR}/vector-calc"
install -Dm755 build/libvector-math.so.1.0.0 "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/libvector-math.so.1.0.0"
ln -s libvector-math.so.1.0.0 "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/libvector-math.so.1"
ln -s libvector-math.so.1 "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/libvector-math.so"
install -Dm644 include/vector-math.h "${CAST_INSTALL_ROOT}${CAST_PREFIX}/include/vector-math/vector-math.h"
"#,
        },
    ],
    check = a.phase [
        a.step.run (a.program.binary "test") ["-s", "build/libvector-math.so.1.0.0"],
        a.step.run (a.program.binary "test") ["-x", "build/vector-calc"],
    ],
    workload = a.phase [],
}

let root = {
    summary = a.optional.set "Vector calculation command-line tool",
    runtime_inputs = [a.dep.output (a.package_ref pname) "libs"],
    paths = [a.path.exe "/usr/bin/vector-calc"],
    .. a.output "out"
}

let libraries = {
    summary = a.optional.set "Vector math runtime library",
    paths = [a.path.any "/usr/lib/libvector-math.so.*"],
    .. a.output "libs"
}

let development = {
    summary = a.optional.set "Vector math headers and link-time library",
    runtime_inputs = [a.dep.output (a.package_ref pname) "libs"],
    paths = [
        a.path.any "/usr/include/vector-math",
        a.path.symlink "/usr/lib/libvector-math.so",
    ],
    .. a.output "devel"
}

{
    meta = {
        pname,
        version = "3.2.0",
        release = 1,
        homepage = "https://example.invalid/vector-math",
        license = ["BSD-2-Clause"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mkdir",
        a.dep.binary "cc",
        a.dep.binary "install",
        a.dep.binary "ln",
        a.dep.binary "test",
    ],
    sources = [
        a.source.archive
            "https://example.invalid/vector-math-3.2.0.tar.xz"
            "6789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012345",
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, libraries, development],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64", "aarch64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
