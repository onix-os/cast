let a = import! cast.authored.v1

// External executables are typed provider capabilities; the generated ELF
// is a distinct native build-tree executable. Scripts use Shell explicitly.
let phases = a.scripts {
    setup = a.phase [
        a.step.run (a.program.binary "mkdir") ["-p", "build"],
    ],
    build = a.phase [
        a.step.run
            (a.program.package (a.package_ref "schema-compiler") "/opt/schema-compiler/bin/schema-compile")
            ["--input", "schema", "--output", "build/generated.c"],
        a.step.run (a.program.binary "cc") ["build/generated.c", "-o", "build/custom-tool"],
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [
                a.program.binary "install",
                a.program.binary "ln",
            ],
            script = r#"
install -Dm755 build/custom-tool "${CAST_INSTALL_ROOT}${CAST_BINDIR}/custom-tool"
ln -s custom-tool "${CAST_INSTALL_ROOT}${CAST_BINDIR}/custom-tool-compat"
"#,
        },
    ],
    check = a.phase [
        a.step.run_built
            (a.program.built "build/custom-tool")
            [],
    ],
    workload = a.phase [],
}

{
    meta = {
        pname = "custom-steps",
        version = "1.1.0",
        release = 1,
        homepage = "https://example.invalid/custom-steps",
        license = ["ISC"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mkdir",
        a.dep.package "schema-compiler",
        a.dep.binary "cc",
        a.dep.binary "install",
        a.dep.binary "ln",
    ],
    sources = [
        a.source.archive
            "https://example.invalid/custom-steps-1.1.0.tar.xz"
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.default,
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
