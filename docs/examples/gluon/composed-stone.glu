let a = import! cast.authored.v1
let package_policy = import! "./package_policy.glu"

// Composition example: an imported policy decorates the root output, and the
// shared `outputs.with_root` overlays it onto the default split-output set.
{
    meta = {
        pname = "composed-hello",
        version = "1.0.0",
        release = 1,
        homepage = "https://example.invalid/composed-hello",
        license = ["MPL-2.0"],
    },
    builder = a.builder.custom a.empty.builder,
    sources = [],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.with_root (package_policy (a.output "out")),
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
