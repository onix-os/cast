let a = import! cast.authored.v1

// Minimal authored recipe example. Every field of the package record is named
// directly; `outputs.default` selects the shared Rust split-output policy and
// `unset` selects the versioned option/hook defaults. No authoring logic runs in
// Gluon — the shared `lower` completes the package.
{
    meta = {
        pname = "hello",
        version = "1.0.0",
        release = 1,
        homepage = "https://example.invalid/hello",
        license = ["MPL-2.0"],
    },
    builder = a.builder.custom a.empty.builder,
    sources = [],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.with_root {
        summary = a.optional.set "Minimal Gluon recipe example",
        .. a.output "out"
    },
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
