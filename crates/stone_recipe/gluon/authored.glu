
// Embedded, pure authoring prelude imported by recipes as `cast.authored.v1`.
//
// This is a TYPE + CONSTRUCTOR layer only. It carries NO defaults, NO builder
// expansion, and NO patch/merge logic: those moved to shared Rust
// (`stone_recipe::package::{lower, lower_builder, default_output_set}`). A recipe
// imports this prelude, builds the minimal authored record directly, names its
// builder by request (`builder.cmake { .. }` / `builder.shell ..`), and selects a
// Rust default with `unset`. The shared `lower` then fills the package-ABI
// defaults and lowers the builder request into typed steps. Gluon and Lua author
// the identical shape; neither hosts authoring logic.

let _ = import! std.types
let strings = import! std.string.prim

type Bool =
    | False
    | True

type Optional a =
    | Unset
    | Set a

type MetaSpec = {
    pname: String,
    version: String,
    release: Int,
    homepage: String,
    license: Array String,
}

type PackageRef = { name: String }

type OutputRef = {
    package: PackageRef,
    output: String,
}

type DependencySpec =
    | Package { value: PackageRef }
    | Output { value: OutputRef }
    | Binary { target: String }
    | SystemBinary { target: String }
    | PkgConfig { target: String }
    | PkgConfig32 { target: String }
    | Soname { target: String }
    | CMake { target: String }
    | Python { target: String }
    | Interpreter { target: String }

type ProgramSpec = {
    path: String,
    requirement: DependencySpec,
}

type BuiltProgramSpec = { path: String }

type StepSpec =
    | Run { program: ProgramSpec, args: Array String }
    | RunBuilt { program: BuiltProgramSpec, args: Array String }
    | Shell {
        interpreter: ProgramSpec,
        declared_programs: Array ProgramSpec,
        script: String,
    }
    | CMakeConfigure { flags: Array String }
    | CMakeBuild
    | CMakeInstall
    | CMakeTest
    | MesonSetup { flags: Array String }
    | MesonBuild
    | MesonInstall
    | MesonTest
    | CargoBuild { features: Array String }
    | CargoInstall { binaries: Array String }
    | CargoTest { features: Array String }
    | AutotoolsConfigure { flags: Array String }
    | AutotoolsBuild
    | AutotoolsInstall
    | AutotoolsTest

type PhaseSpec = {
    steps: Array StepSpec,
}

type ScriptsSpec = {
    setup: PhaseSpec,
    build: PhaseSpec,
    install: PhaseSpec,
    check: PhaseSpec,
    workload: PhaseSpec,
}

type HooksSpec = {
    pre_setup: Array StepSpec,
    post_setup: Array StepSpec,
    pre_build: Array StepSpec,
    post_build: Array StepSpec,
    pre_check: Array StepSpec,
    post_check: Array StepSpec,
    pre_install: Array StepSpec,
    post_install: Array StepSpec,
    pre_workload: Array StepSpec,
    post_workload: Array StepSpec,
}

type BuilderEnvironmentSpec =
    | CMakeEnvironment
    | MesonEnvironment
    | CargoEnvironment
    | AutotoolsEnvironment

type SupportedHooksSpec = {
    setup: Bool,
    build: Bool,
    check: Bool,
    install: Bool,
    workload: Bool,
}

type BuilderSpec = {
    required_tools: Array DependencySpec,
    environment: Array BuilderEnvironmentSpec,
    phases: ScriptsSpec,
    supported_hooks: SupportedHooksSpec,
}

type PathSpec =
    | Any { path: String }
    | Exe { path: String }
    | Symlink { path: String }
    | Special { path: String }

type OutputSpec = {
    name: String,
    include_in_manifest: Bool,
    summary: Optional String,
    description: Optional String,
    provides_exclude: Array String,
    runtime_inputs: Array DependencySpec,
    runtime_exclude: Array String,
    paths: Array PathSpec,
    conflicts: Array DependencySpec,
}

type ToolchainSpec =
    | LlvmToolchain
    | GnuToolchain

type OptionsSpec = {
    toolchain: ToolchainSpec,
    cspgo: Bool,
    samplepgo: Bool,
    debug: Bool,
    strip: Bool,
    networking: Bool,
    compressman: Bool,
    lastrip: Bool,
}

type ProfileSpec = {
    name: String,
    builder: BuilderSpec,
    hooks: HooksSpec,
    native_build_inputs: Array DependencySpec,
    build_inputs: Array DependencySpec,
    check_inputs: Array DependencySpec,
}

type UpstreamSpec =
    | ArchiveSource {
        url: String,
        hash: String,
        rename: Optional String,
        strip_dirs: Optional Int,
        unpack: Bool,
        unpack_dir: Optional String,
    }
    | GitSource {
        url: String,
        git_ref: String,
        clone_dir: Optional String,
    }

type TuningSpec =
    | Enable
    | Disable
    | Config { value: String }

type NamedTuningSpec = {
    key: String,
    value: TuningSpec,
}

// The authored choice for the output set. A dedicated (non-`Optional`) type is
// required because `OutputSpec` itself carries `Optional String` fields: wrapping
// it in `Optional` would nest `Optional` within `Optional`, which Gluon's
// unifier cannot reconcile against the structural decode type. `Default` selects
// the shared Rust `default_output_set`; `Explicit` overrides it wholesale.
type OutputsChoice =
    | DefaultOutputs
    | ExplicitOutputs (Array OutputSpec)

// The minimal builder authoring request. The four standard build systems carry
// only their flags/features; `Custom` is the explicit data escape hatch — a
// complete `BuilderSpec` authored directly. The shared Rust `lower_builder`
// expands the standard kinds into tools/environment/typed step phases.
type BuilderRequest =
    | Cmake { flags: Array String, run_tests: Bool }
    | Meson { flags: Array String, run_tests: Bool }
    | Cargo { features: Array String, binaries: Array String, run_tests: Bool }
    | Autotools { flags: Array String, run_tests: Bool }
    | Custom BuilderSpec

// ---- trivial constructors (data shapes only, no authoring logic) ----

let empty_phase: PhaseSpec = { steps = [] }

let empty_scripts: ScriptsSpec = {
    setup = empty_phase,
    build = empty_phase,
    install = empty_phase,
    check = empty_phase,
    workload = empty_phase,
}

let empty_hooks: HooksSpec = {
    pre_setup = [],
    post_setup = [],
    pre_build = [],
    post_build = [],
    pre_check = [],
    post_check = [],
    pre_install = [],
    post_install = [],
    pre_workload = [],
    post_workload = [],
}

let all_hooks_supported: SupportedHooksSpec = {
    setup = True,
    build = True,
    check = True,
    install = True,
    workload = True,
}

let empty_custom_builder: BuilderSpec = {
    required_tools = [],
    environment = [],
    phases = empty_scripts,
    supported_hooks = all_hooks_supported,
}

let output: String -> OutputSpec = \name -> {
    name,
    include_in_manifest = True,
    summary = Unset,
    description = Unset,
    provides_exclude = [],
    runtime_inputs = [],
    runtime_exclude = [],
    paths = [],
    conflicts = [],
}

let package_ref = \name -> { name }
let output_ref = \package output -> { package, output }
let named = \key value -> { key, value }

let binary_program: String -> ProgramSpec = \target -> {
    path = strings.append "/usr/bin/" target,
    requirement = Binary { target },
}

let system_binary_program: String -> ProgramSpec = \target -> {
    path = strings.append "/usr/sbin/" target,
    requirement = SystemBinary { target },
}

let package_program: PackageRef -> String -> ProgramSpec = \package path -> {
    path,
    requirement = Package { value = package },
}

let output_program: OutputRef -> String -> ProgramSpec = \output path -> {
    path,
    requirement = Output { value = output },
}

let built_program: String -> BuiltProgramSpec = \path -> { path }

let bash_program = binary_program "bash"

let archive = \url hash -> ArchiveSource {
    url,
    hash,
    rename = Unset,
    strip_dirs = Unset,
    unpack = True,
    unpack_dir = Unset,
}

let git = \url git_ref -> GitSource {
    url,
    git_ref,
    clone_dir = Unset,
}

// Monomorphic optional wrappers for the authored record's `options`/`hooks`
// overrides. A *polymorphic* `Set` inferred inside the record literal can make
// Gluon mis-unify against the structural decode type; naming the concrete result
// type sidesteps that inference path. (`outputs` uses `OutputsChoice`, above.)
let some_options: OptionsSpec -> Optional OptionsSpec = \value -> Set value
let some_hooks: HooksSpec -> Optional HooksSpec = \value -> Set value

{
    abi_version = 1,
    Bool,
    Optional,
    BuilderRequest,
    true = True,
    false = False,
    unset = Unset,
    set = \value -> Set value,
    optional = {
        unset = Unset,
        set = \value -> Set value,
    },
    boolean = {
        false = False,
        true = True,
    },
    meta = \value -> value,
    scripts = \value -> value,
    phase = \steps -> { steps },
    hooks = \value -> value,
    options = \value -> value,
    profile = \value -> value,
    output,
    output_with = \value -> value,
    named,
    package_ref,
    output_ref,
    empty = {
        hooks = empty_hooks,
        scripts = empty_scripts,
        builder = empty_custom_builder,
    },
    // The authored output-set choice: default (Rust fills it) or explicit.
    outputs = {
        default = DefaultOutputs,
        explicit = \values -> ExplicitOutputs values,
    },
    // Monomorphic optional overrides for the authored record (see `some_*`).
    // (`with` is a reserved word in Gluon, so this namespace is `some`.)
    some = {
        options = some_options,
        hooks = some_hooks,
    },
    builder = {
        cmake = \config -> Cmake config,
        meson = \config -> Meson config,
        cargo = \config -> Cargo config,
        autotools = \config -> Autotools config,
        custom = \spec -> Custom spec,
        // A structured custom builder from explicit phases + required tools.
        shell = \phases required_tools -> Custom {
            required_tools,
            environment = [],
            phases,
            supported_hooks = all_hooks_supported,
        },
    },
    step = {
        run = \program args -> Run { program, args },
        run_built = \program args -> RunBuilt { program, args },
        shell = \script -> Shell {
            interpreter = bash_program,
            declared_programs = [],
            script,
        },
        shell_with = \value -> Shell value,
        cmake_configure = \flags -> CMakeConfigure { flags },
        cmake_build = CMakeBuild,
        cmake_install = CMakeInstall,
        cmake_test = CMakeTest,
        meson_setup = \flags -> MesonSetup { flags },
        meson_build = MesonBuild,
        meson_install = MesonInstall,
        meson_test = MesonTest,
        cargo_build = \features -> CargoBuild { features },
        cargo_install = \binaries -> CargoInstall { binaries },
        cargo_test = \features -> CargoTest { features },
        autotools_configure = \flags -> AutotoolsConfigure { flags },
        autotools_build = AutotoolsBuild,
        autotools_install = AutotoolsInstall,
        autotools_test = AutotoolsTest,
    },
    program = {
        binary = binary_program,
        system_binary = system_binary_program,
        package = package_program,
        output = output_program,
        built = built_program,
    },
    dep = {
        package = \name -> Package { value = package_ref name },
        output = \package output -> Output { value = output_ref package output },
        binary = \target -> Binary { target },
        system_binary = \target -> SystemBinary { target },
        pkgconfig = \target -> PkgConfig { target },
        pkgconfig32 = \target -> PkgConfig32 { target },
        soname = \target -> Soname { target },
        cmake = \target -> CMake { target },
        python = \target -> Python { target },
        interpreter = \target -> Interpreter { target },
    },
    source = {
        archive,
        archive_with = \value -> ArchiveSource value,
        git,
        git_with = \value -> GitSource value,
    },
    path = {
        any = \path -> Any { path },
        exe = \path -> Exe { path },
        symlink = \path -> Symlink { path },
        special = \path -> Special { path },
    },
    tuning = {
        enable = Enable,
        disable = Disable,
        config = \value -> Config { value },
    },
    toolchain = {
        llvm = LlvmToolchain,
        gnu = GnuToolchain,
    },
    environment = {
        cmake = CMakeEnvironment,
        meson = MesonEnvironment,
        cargo = CargoEnvironment,
        autotools = AutotoolsEnvironment,
    },
    hook_support = {
        all = all_hooks_supported,
    },
}
