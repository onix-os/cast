let a = import! cast.authored.v1

let scripts = a.scripts {
    setup = a.phase [a.step.shell_with {
        interpreter = a.program.binary "bash",
        declared_programs = [a.program.binary "touch"],
        script = "for f in a b c d e f g h; do touch $f; done",
    }],
    build = a.phase [a.step.shell "for f in a b c d e f g h; do echo $f >> build.log; done"],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm00644 build.log "${CAST_INSTALL_ROOT}${CAST_LIBEXECDIR}/build.log""#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Concurrency test for Cast",
    description = a.optional.set "Concurrency test for Cast",
    .. a.output "out"
}

{
    meta = {
        pname = "cast-concurrency-test",
        version = "1",
        release = 1,
        homepage = "https://github.com/bresilla/os-tools",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell scripts [],
    sources = [],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.with_root root,
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
