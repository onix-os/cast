
let a = import! cast.authored.v1
let scripts = a.scripts {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "mkdir", a.program.binary "touch"],
            script = r#"mkdir -p "${CAST_INSTALL_ROOT}${CAST_VENDORDIR}" && touch "${CAST_INSTALL_ROOT}${CAST_VENDORDIR}/pineapple""#,
        },
    ],
    .. a.empty.scripts
}
let root = {
    summary = a.optional.set "Delicious slices of pineapples",
    description = a.optional.set "Can I be on your pizza?",
    .. a.output "out"
}
{
    meta = {
        pname = "pineapple",
        version = "1",
        release = 1,
        homepage = "https://github.com/serpent-os",
        license = ["Zlib"],
    },
    builder = a.builder.shell scripts [],
    sources = [],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.with_root root,
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
