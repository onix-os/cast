let a = import! cast.authored.v1

let phases = a.scripts {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "dash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm644 include/vector.h "${CAST_INSTALL_ROOT}${CAST_PREFIX}/include/cast-header-only/vector.h"
install -Dm644 cast-header-only.pc "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/pkgconfig/cast-header-only.pc"
install -Dm644 LICENSE "${CAST_INSTALL_ROOT}${CAST_DATADIR}/licenses/cast-header-only-library-fixture/LICENSE""#,
        },
    ],
    check = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "dash",
            declared_programs = [a.program.binary "cc"],
            script = r#"test ! -e include/cast-header-only/vector.h
test -f "${CAST_INSTALL_ROOT}${CAST_PREFIX}/include/cast-header-only/vector.h"
cc -std=c11 -Wall -Wextra -Werror -pedantic-errors -nostdinc -I"${CAST_INSTALL_ROOT}${CAST_PREFIX}/include" -fsyntax-only tests/consumer.c"#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Header-only fixture license metadata",
    paths = [a.path.any "/usr/share/licenses/cast-header-only-library-fixture"],
    .. a.output "out"
}

let development = {
    summary = a.optional.set "Staged header-only development interface",
    paths = [
        a.path.any "/usr/include/cast-header-only",
        a.path.any "/usr/lib/pkgconfig/cast-header-only.pc",
    ],
    .. a.output "devel"
}

{
    meta = {
        pname = "cast-header-only-library-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-header-only-library-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "cc",
        a.dep.binary "install",
        a.dep.binary "dash",
    ],
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-header-only-library-fixture-1.0.0.tar",
            hash = "ab0bc1ad844befe29383465ad24872f6314ae01fa3c7456679a41372d37a492e",
            rename = a.optional.set "cast-header-only-library-fixture.tar",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-header-only-library-fixture",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, development],
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
