
let a = import! cast.authored.v1

// A Stone-native package factory: callers inject typed package values, then
// may apply an explicit record update to the returned immutable package.
\inputs ->
    {
        meta = inputs.meta,
        builder = inputs.builder,
        sources = inputs.sources,
        native_build_inputs = [],
        build_inputs = [],
        check_inputs = [],
        outputs = a.outputs.default,
        options = a.unset,
        profiles = [],
        architectures = inputs.architectures,
        tuning = [],
        emul32 = a.false,
        mold = a.false,
        hooks = a.unset,
    }
