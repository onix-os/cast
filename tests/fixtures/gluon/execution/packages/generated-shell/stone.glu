let a = import! cast.authored.v1

let phases = a.scripts {
    build = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [],
            script = r#"
printf '%s\n' \
    '#!/usr/bin/bash' \
    'set -euo pipefail' \
    '' \
    'if [[ "$#" -eq 0 ]]; then' \
    "    printf '%s\\n' 'cast-generated-shell'" \
    'elif [[ "$#" -eq 1 && "$1" == --self-test ]]; then' \
    "    printf '%s\\n' 'cast-generated-shell: self-test passed'" \
    'else' \
    "    printf '%s\\n' 'usage: cast-generated-shell [--self-test]' >&2" \
    '    exit 64' \
    'fi' \
    > cast-generated-shell
"#,
        },
    ],
    check = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [],
            script = r#"
actual="$(source ./cast-generated-shell --self-test)"
if [[ "${actual}" != 'cast-generated-shell: self-test passed' ]]; then
    printf '%s\n' 'generated shell self-test output differed' >&2
    exit 1
fi

set +e
(source ./cast-generated-shell --unexpected >/dev/null 2>&1)
status="$?"
set -e
if [[ "${status}" -ne 64 ]]; then
    printf 'unexpected-argument status was %s, expected 64\n' "${status}" >&2
    exit 1
fi
"#,
        },
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm755 cast-generated-shell "${CAST_INSTALL_ROOT}${CAST_BINDIR}/cast-generated-shell""#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Gluon-authored shell application fixture",
    runtime_inputs = [a.dep.binary "bash"],
    paths = [a.path.exe "/usr/bin/cast-generated-shell"],
    .. a.output "out"
}

{
    meta = {
        pname = "cast-generated-shell-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-generated-shell-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "bash",
        a.dep.binary "install",
    ],
    sources = [],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
