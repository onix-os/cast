let a = import! cast.authored.v1

let phases = a.scripts {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"
printf '%s\n' \
    'schema = 1' \
    'native-build = "sysbinary(ldconfig)"' \
    'build = "pkgconfig32(zlib)"' \
    'runtime-interpreter = "interpreter(/usr/lib/ld-linux-x86-64.so.2(x86_64))"' \
    'runtime-library = "soname(libz.so.1(x86_64))"' \
    > relation-policy.conf
install -Dm644 relation-policy.conf \
    "${CAST_INSTALL_ROOT}${CAST_DATADIR}/cast/relation-policy.conf"
"#,
        },
    ],
    .. a.empty.scripts
}

let root = {
    summary = a.optional.set "Typed dependency-role policy fixture",
    description = a.optional.set "Pinned build and runtime capabilities with exact provider identities.",
    runtime_inputs = [
        a.dep.interpreter "/usr/lib/ld-linux-x86-64.so.2(x86_64)",
        a.dep.soname "libz.so.1(x86_64)",
    ],
    paths = [a.path.any "/usr/share/cast/relation-policy.conf"],
    .. a.output "out"
}

{
    meta = {
        pname = "cast-relation-policy-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-relation-policy-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "bash",
        a.dep.binary "install",
    ],
    sources = [],
    native_build_inputs = [a.dep.system_binary "ldconfig"],
    build_inputs = [a.dep.pkgconfig32 "zlib"],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
