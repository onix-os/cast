let a = import! cast.authored.v1

let bash = a.program.binary "bash"
let go = a.program.binary "go"
let install = a.program.binary "install"

let phases = a.scripts {
    setup = a.phase [
        a.step.shell_with {
            interpreter = bash,
            declared_programs = [],
            script = r#"test -s go.mod
test -s go.sum
test -s vendor/modules.txt
test -s vendor/fixtures.invalid/cast/go-message/message.go
test ! -e go.work
test ! -e vendor/fixtures.invalid/cast/go-message/go.mod
replace_pattern='^[[:space:]]*replace([[:space:](]|$)'
while IFS= read -r line; do
    [[ ! $line =~ $replace_pattern ]] || exit 1
done < go.mod"#,
        },
    ],
    build = a.phase [
        a.step.shell_with {
            interpreter = bash,
            declared_programs = [go],
            script = r#"export HOME="${CAST_BUILD_ROOT}/home"
export XDG_CONFIG_HOME="${CAST_BUILD_ROOT}/xdg-config"
export GOROOT=/usr/lib/golang
export GOCACHE="${CAST_BUILD_ROOT}/go-cache"
export GOMODCACHE="${CAST_BUILD_ROOT}/go-mod-cache"
export GOENV=off
export GOWORK=off
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GONOSUMDB='*'
export GONOPROXY=none
export GOFLAGS=
export GO111MODULE=on
export CGO_ENABLED=0
export GOOS=linux
export GOARCH=amd64
export GOAMD64=v1
go telemetry off
go build -mod=vendor -trimpath -buildvcs=false -ldflags='-buildid= -s -w' -o cast-go-module-fixture ./cmd/cast-go-module-fixture"#,
        },
    ],
    check = a.phase [
        a.step.shell_with {
            interpreter = bash,
            declared_programs = [go],
            script = r#"export HOME="${CAST_BUILD_ROOT}/home"
export XDG_CONFIG_HOME="${CAST_BUILD_ROOT}/xdg-config"
export GOROOT=/usr/lib/golang
export GOCACHE="${CAST_BUILD_ROOT}/go-cache"
export GOMODCACHE="${CAST_BUILD_ROOT}/go-mod-cache"
export GOENV=off
export GOWORK=off
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GONOSUMDB='*'
export GONOPROXY=none
export GOFLAGS=
export GO111MODULE=on
export CGO_ENABLED=0
export GOOS=linux
export GOARCH=amd64
export GOAMD64=v1
go telemetry off
go test -mod=vendor -trimpath -count=1 ./..."#,
        },
        a.step.run_built
            (a.program.built "cast-go-module-fixture")
            ["--self-test"],
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = bash,
            declared_programs = [install],
            script = r#"install -Dm755 cast-go-module-fixture "${CAST_INSTALL_ROOT}${CAST_BINDIR}/cast-go-module-fixture"
install -Dm644 LICENSE "${CAST_INSTALL_ROOT}${CAST_DATADIR}/licenses/cast-go-module-fixture/LICENSE""#,
        },
    ],
    .. a.empty.scripts
}

let root = a.output_with {
    summary = a.optional.set "Pinned offline Go module fixture",
    description = a.optional.set "A reproducible static Go executable built exclusively from an exact self-authored vendor tree.",
    runtime_inputs = [],
    paths = [
        a.path.exe "/usr/bin/cast-go-module-fixture",
        a.path.any "/usr/share/licenses/cast-go-module-fixture/LICENSE",
    ],
    .. a.output "out"
}

{
    meta = {
        pname = "cast-go-module-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-go-module-fixture",
        license = ["MIT"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "bash",
        a.dep.binary "go",
        a.dep.binary "install",
    ],
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-go-module-fixture-1.0.0.tar.zst",
            hash = "f4c4eb74304956e3f3e650d2004c78a39c4d4c009e447b9c28b3819370dbc78f",
            rename = a.optional.set "cast-go-module-fixture.tar.zst",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-go-module-fixture",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
