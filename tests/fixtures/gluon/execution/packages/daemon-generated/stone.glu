
let a = import! cast.authored.v1

let pname = "cast-daemon-fixture"

let root = {
    summary = a.optional.set "Daemon fixture, service unit, and generated defaults",
    paths = [
        a.path.exe "/usr/sbin/cast-daemon-fixture",
        a.path.any "/usr/lib/systemd/system/cast-daemon.service",
        a.path.any "/usr/share/defaults/cast-daemon-fixture",
    ],
    .. a.output "out"
}

let documentation = {
    include_in_manifest = a.false,
    summary = a.optional.set "Daemon fixture administrator manual",
    paths = [a.path.any "/usr/share/man/man8/cast-daemon.8"],
    .. a.output "docs"
}

let debugging = {
    include_in_manifest = a.false,
    summary = a.optional.set "Daemon fixture debugging symbols",
    paths = [a.path.any "/usr/lib/debug"],
    .. a.output "dbginfo"
}

{
    meta = {
        pname,
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-daemon-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.cmake { flags = [], run_tests = a.true },
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-daemon-fixture-1.0.0.tar.zst",
            hash = "7d01ab16acc6b96925e8f996e8fbaea4d11b448bccc44d40090bbdc7963e617b",
            rename = a.optional.set "cast-daemon-fixture.tar.zst",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-daemon-fixture",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, documentation, debugging],
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
