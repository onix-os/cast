let a = import! cast.authored.v1

let phases = a.scripts {
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"
printf '%s\n' \
    'format = 1' \
    'profile = "stone-native"' \
    'source = "gluon"' \
    > generated-config.conf
install -Dm644 generated-config.conf \
    "${CAST_INSTALL_ROOT}${CAST_DATADIR}/cast/generated-config.conf"
"#,
        },
    ],
    .. a.empty.scripts
}

{
    meta = {
        pname = "cast-generated-config-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-generated-config-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "bash",
        a.dep.binary "install",
    ],
    sources = [],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [
        a.output_with {
            summary = a.optional.set "Stone-native generated configuration fixture",
            paths = [a.path.any "/usr/share/cast/generated-config.conf"],
            .. a.output "out"
        },
    ],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
