
let a = import! cast.authored.v1

let phases = a.scripts {
    setup = a.phase [
        a.step.run (a.program.binary "mkdir") ["-p", "build"],
    ],
    build = a.phase [
        a.step.run
            (a.program.binary "cc")
            [
                "-O2",
                "-g",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-fstack-protector-strong",
                "-D_FORTIFY_SOURCE=3",
                "-fPIE",
                "main.c",
                "-Wl,-pie",
                "-Wl,-z,relro,-z,now",
                "-Wl,--as-needed",
                "-o",
                "build/cast-custom-fixture",
            ],
    ],
    check = a.phase [
        a.step.run_built
            (a.program.built "build/cast-custom-fixture")
            ["--self-test"],
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "dash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm755 build/cast-custom-fixture "${CAST_INSTALL_ROOT}${CAST_BINDIR}/cast-custom-fixture""#,
        },
    ],
    .. a.empty.scripts
}

{
    meta = {
        pname = "cast-custom-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-custom-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mkdir",
        a.dep.binary "cc",
        a.dep.binary "install",
        a.dep.binary "dash",
    ],
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-custom-fixture-1.0.0.tar",
            hash = "76cf98a8eef6104059a60cd78e839f94c279ee2a415c36bc98bc3793b416838c",
            rename = a.optional.set "cast-custom-fixture.tar",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-custom-fixture",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.default,
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
