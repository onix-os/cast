let a = import! cast.authored.v1

let copy_test_vectors = a.step.shell_with {
    interpreter = a.program.binary "bash",
    declared_programs = [a.program.binary "cp"],
    script = r#"test ! -e "${CAST_BUILDER_DIR}/external-test-vectors.json" && cp --preserve=mode,timestamps -- "${CAST_SOURCE_DIR}/external-test-vectors.json" "${CAST_BUILDER_DIR}/external-test-vectors.json" && test -f "${CAST_BUILDER_DIR}/external-test-vectors.json" && test ! -L "${CAST_BUILDER_DIR}/external-test-vectors.json" && test -s "${CAST_BUILDER_DIR}/external-test-vectors.json""#,
}

let root = {
    summary = a.optional.set "Frame codec checked against an independently locked corpus",
    description = a.optional.set "A real CMake/CTest build whose check-only corpus never enters the installed output.",
    paths = [a.path.exe "/usr/bin/cast-external-test-vectors-fixture"],
    .. a.output "out"
}

let debugging = {
    include_in_manifest = a.false,
    summary = a.optional.set "Frame codec debugging symbols",
    paths = [a.path.any "/usr/lib/debug"],
    .. a.output "dbginfo"
}

{
    meta = {
        pname = "cast-external-test-vectors-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-external-test-vectors-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.cmake {
        flags = [
            "-DBUILD_TESTING=ON",
            "-DCAST_EXTERNAL_VECTOR_FILE=external-test-vectors.json",
        ],
        run_tests = a.true,
    },
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-external-test-vectors-fixture-1.0.0.tar",
            hash = "c04932c66a3399d95fda58b459b7f3e903454e5d2963f3529667216fdad50404",
            rename = a.optional.set "cast-external-test-vectors-fixture.tar",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-external-test-vectors-fixture",
        },
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-external-test-vectors-fixture-1.0.0-vectors.json",
            hash = "c957dce5105c8add6e581f9aa0ee34002cbff8c9d403fab5132cebf0a8c7685c",
            rename = a.optional.set "external-test-vectors.json",
            strip_dirs = a.optional.unset,
            unpack = a.false,
            unpack_dir = a.optional.unset,
        },
    ],
    native_build_inputs = [a.dep.binary "cp"],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, debugging],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.some.hooks (a.hooks {
        pre_check = [copy_test_vectors],
        .. a.empty.hooks
    }),
}
