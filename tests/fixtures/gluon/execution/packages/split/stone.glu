
let a = import! cast.authored.v1

let pname = "cast-split-fixture"

let root = a.output_with {
    summary = a.optional.set "Split fixture executable and manual page",
    paths = [
        a.path.exe "/usr/bin/cast-split-fixture",
        a.path.any "/usr/share/man/man1",
    ],
    .. a.output "out"
}

let libraries = a.output_with {
    summary = a.optional.set "Split fixture runtime library",
    paths = [a.path.any "/usr/lib/libcast-split.so.*"],
    .. a.output "libs"
}

let development = a.output_with {
    summary = a.optional.set "Split fixture development files",
    runtime_inputs = [a.dep.output (a.package_ref pname) "libs"],
    paths = [
        a.path.any "/usr/include/cast-split",
        a.path.any "/usr/lib/libcast-split.so",
        a.path.any "/usr/lib/pkgconfig/cast-split.pc",
    ],
    .. a.output "devel"
}

let documentation = a.output_with {
    include_in_manifest = a.false,
    summary = a.optional.set "Split fixture documentation",
    paths = [a.path.any "/usr/share/doc/cast-split-fixture"],
    .. a.output "docs"
}

let debugging = a.output_with {
    include_in_manifest = a.false,
    summary = a.optional.set "Split fixture debugging symbols",
    paths = [a.path.any "/usr/lib/debug"],
    .. a.output "dbginfo"
}

{
    meta = {
        pname,
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-split-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.cmake {
        flags = ["-DCMAKE_INSTALL_DOCDIR=/usr/share/doc/cast-split-fixture"],
        run_tests = a.true,
    },
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-split-fixture-1.0.0.tar",
            hash = "bd78efc34e46566f967ae963c895c1e7d9de45da7d7022c5c4f6683425ae567d",
            rename = a.optional.set "cast-split-fixture.tar",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-split-fixture",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, libraries, development, documentation, debugging],
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
