let a = import! cast.authored.v1

let domain = "cast-gettext-localization-fixture"

let phases = {
    setup = a.phase [
        a.step.run (a.program.binary "mkdir") ["-p", "build/locale/fr/LC_MESSAGES"],
        a.step.run (a.program.binary "mkdir") ["-p", "build/locale/de/LC_MESSAGES"],
    ],
    build = a.phase [
        a.step.run (a.program.binary "msgfmt") [
            "--check-format",
            "--check-header",
            "-o",
            "build/locale/fr/LC_MESSAGES/cast-gettext-localization-fixture.mo",
            "po/fr.po",
        ],
        a.step.run (a.program.binary "msgfmt") [
            "--check-format",
            "--check-header",
            "-o",
            "build/locale/de/LC_MESSAGES/cast-gettext-localization-fixture.mo",
            "po/de.po",
        ],
        a.step.run (a.program.binary "cc") [
            "-std=c11",
            "-O2",
            "-g",
            "-Wall",
            "-Wextra",
            "-Werror",
            "-fstack-protector-strong",
            "-D_FORTIFY_SOURCE=3",
            "-fPIE",
            "consumer.c",
            "-Wl,-pie",
            "-Wl,--build-id=sha1",
            "-Wl,-z,relro,-z,now",
            "-Wl,-z,noexecstack",
            "-Wl,-z,separate-code",
            "-Wl,--as-needed",
            "-o",
            "build/gettext-consumer",
        ],
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "bash",
            declared_programs = [a.program.binary "install"],
            script = r#"install -Dm644 build/locale/fr/LC_MESSAGES/cast-gettext-localization-fixture.mo "${CAST_INSTALL_ROOT}${CAST_DATADIR}/locale/fr/LC_MESSAGES/cast-gettext-localization-fixture.mo"
install -Dm644 build/locale/de/LC_MESSAGES/cast-gettext-localization-fixture.mo "${CAST_INSTALL_ROOT}${CAST_DATADIR}/locale/de/LC_MESSAGES/cast-gettext-localization-fixture.mo"
install -Dm644 COPYING "${CAST_INSTALL_ROOT}${CAST_DATADIR}/licenses/cast-gettext-localization-fixture/COPYING""#,
        },
    ],
    check = a.phase [
        a.step.run_built
            (a.program.built "build/gettext-consumer")
            ["fr_FR.utf8", "build/locale", "Bonjour de Cast"],
        a.step.run_built
            (a.program.built "build/gettext-consumer")
            ["de_DE.utf8", "build/locale", "Hallo von Cast"],
    ],
    workload = a.empty.scripts.workload,
}

let root = {
    summary = a.optional.set "Compiled French and German gettext catalogs",
    description = a.optional.set "Two validated message catalogs whose translations are exercised by a build-only libc gettext consumer.",
    paths = [
        a.path.any "/usr/share/locale/fr/LC_MESSAGES/cast-gettext-localization-fixture.mo",
        a.path.any "/usr/share/locale/de/LC_MESSAGES/cast-gettext-localization-fixture.mo",
        a.path.any "/usr/share/licenses/cast-gettext-localization-fixture/COPYING",
    ],
    .. a.output "out"
}

{
    meta = {
        pname = domain,
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-gettext-localization-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mkdir",
        a.dep.binary "msgfmt",
        a.dep.binary "cc",
        a.dep.binary "bash",
        a.dep.binary "install",
    ],
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-gettext-localization-fixture-1.0.0.tar",
            hash = "1e6b0b3267767853eb622e4155d3c50ecff677f8f3b305f5e4e1470f91fc1e5d",
            rename = a.optional.set "cast-gettext-localization-fixture.tar",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-gettext-localization-fixture",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
