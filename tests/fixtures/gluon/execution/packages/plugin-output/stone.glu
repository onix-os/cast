let a = import! cast.authored.v1

let pname = "cast-plugin-output-fixture"

let phases = a.scripts {
    setup = a.phase [
        a.step.run (a.program.binary "mkdir") ["-p", "build"],
    ],
    build = a.phase [
        a.step.run
            (a.program.binary "cc")
            [
                "-std=c11",
                "-O2",
                "-g",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-fstack-protector-strong",
                "-D_FORTIFY_SOURCE=3",
                "-fPIC",
                "-shared",
                "plugin.c",
                "-Wl,-soname,cast-plugin-output.so",
                "-Wl,--build-id=sha1",
                "-Wl,-z,relro,-z,now",
                "-Wl,-z,noexecstack",
                "-Wl,-z,separate-code",
                "-Wl,--no-undefined",
                "-o",
                "build/cast-plugin-output.so",
            ],
        a.step.run
            (a.program.binary "cc")
            [
                "-std=c11",
                "-O2",
                "-g",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-fstack-protector-strong",
                "-D_FORTIFY_SOURCE=3",
                "-fPIE",
                "host.c",
                "-Wl,-pie",
                "-Wl,--build-id=sha1",
                "-Wl,-z,relro,-z,now",
                "-Wl,-z,noexecstack",
                "-Wl,-z,separate-code",
                "-Wl,--as-needed",
                "-ldl",
                "-o",
                "build/cast-plugin-host",
            ],
    ],
    check = a.phase [
        a.step.run_built
            (a.program.built "build/cast-plugin-host")
            ["--plugin", "build/cast-plugin-output.so"],
    ],
    install = a.phase [
        a.step.shell_with {
            interpreter = a.program.binary "dash",
            declared_programs = [a.program.binary "install"],
            script = r#"
install -Dm755 build/cast-plugin-host \
    "${CAST_INSTALL_ROOT}${CAST_BINDIR}/cast-plugin-host"
install -Dm644 build/cast-plugin-output.so \
    "${CAST_INSTALL_ROOT}${CAST_LIBDIR}/cast/plugins/cast-plugin-output.so"
"#,
        },
    ],
    .. a.empty.scripts
}

let root = a.output_with {
    summary = a.optional.set "Explicit runtime-loaded plugin host",
    runtime_inputs = [a.dep.output (a.package_ref pname) "plugins"],
    paths = [a.path.exe "/usr/bin/cast-plugin-host"],
    .. a.output "out"
}

let plugins = a.output_with {
    summary = a.optional.set "Explicit runtime-loaded plugin",
    paths = [a.path.any "/usr/lib/cast/plugins/cast-plugin-output.so"],
    .. a.output "plugins"
}

let debugging = a.output_with {
    include_in_manifest = a.false,
    summary = a.optional.set "Plugin host and module debugging symbols",
    paths = [a.path.any "/usr/lib/debug"],
    .. a.output "dbginfo"
}

{
    meta = {
        pname,
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-plugin-output-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.shell phases [
        a.dep.binary "mkdir",
        a.dep.binary "cc",
        a.dep.binary "dash",
        a.dep.binary "install",
    ],
    sources = [
        a.source.archive_with {
            url = "https://fixtures.invalid/sources/cast-plugin-output-fixture-1.0.0.tar",
            hash = "467879af548882eb7c2a2197d475b54ec8cc5106c82631b7bd8204b13d8c5319",
            rename = a.optional.set "cast-plugin-output-fixture.tar",
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-plugin-output-fixture",
        },
    ],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [root, plugins, debugging],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
