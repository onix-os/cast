let a = import! cast.authored.v1
let packages = import! "./package_set.glu"
let roles = import! "./roles.glu"

// This package has no sources and no imperative phases. Its empty root output
// is a versioned .stone whose runtime relations are the complete userspace.
{
    meta = {
        pname = "cast-userspace-profile-fixture",
        version = "1.0.0",
        release = 1,
        homepage = "https://fixtures.invalid/cast-userspace-profile-fixture",
        license = ["MPL-2.0"],
    },
    builder = a.builder.custom a.empty.builder,
    sources = [],
    native_build_inputs = [],
    build_inputs = [],
    check_inputs = [],
    outputs = a.outputs.explicit [
        a.output_with {
            summary = a.optional.set "Declarative userspace profile fixture",
            description = a.optional.set "Shell, core commands, discovery, trust, and archive roles composed as one explicit closure.",
            runtime_inputs = roles.complete packages,
            .. a.output "out"
        },
    ],
    options = a.unset,
    profiles = [],
    architectures = ["x86_64"],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
