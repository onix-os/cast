let a = import! cast.authored.v1

// One explicit package set is the only input to the role functions. Nothing
// is discovered from the host or an ambient global package namespace.
{
    shell = a.dep.package "bash",
    core_commands = a.dep.package "uutils-coreutils",
    file_discovery = a.dep.package "findutils",
    trust_store = a.dep.package "ca-certificates",
    archive_tools = a.dep.package "xz",
}
