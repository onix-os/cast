
let a = import! cast.authored.v1

// The legacy recipe overrides only the "out" output's summary/description/
// runtime_inputs via `b.outputs.with_root`, which overlays those fields onto
// the shared default "out" output while leaving every other default output
// (docs, devel, dbginfo, libs, 32bit, 32bit-devel, 32bit-dbginfo, demos)
// untouched. The authored form has no overlay primitive, so the full output
// list is reproduced explicitly here with the same overlay applied by hand.
let pname = "cast"

{
    meta = {
        pname,
        version = "1.0.1",
        release = 35,
        homepage = "https://github.com/bresilla/os-tools",
        license = ["Zlib"],
    },
    builder = a.builder.meson {
        flags = ["--buildtype", "debugoptimized"],
        run_tests = a.false,
    },
    sources = [
        a.source.git "https://github.com/bresilla/os-tools" "v1.0.1",
        a.source.archive_with {
            url = "https://github.com/example/cast-support/releases/download/v1.2.0/cast-support-1.2.0.tar.xz",
            hash = "cbf684b5a37a3a433e0526beb04a7b3419b71e81b3709c3b0d7ed6a1987d3dcb",
            rename = a.optional.unset,
            strip_dirs = a.optional.set 1,
            unpack = a.true,
            unpack_dir = a.optional.set "cast-support",
        },
    ],
    native_build_inputs = [],
    build_inputs = [
        a.dep.package "ldc",
        a.dep.package "ldc-devel",
        a.dep.package "lmdb-devel",
        a.dep.pkgconfig "libcurl",
        a.dep.pkgconfig "libxxhash",
        a.dep.pkgconfig "libzstd",
    ],
    check_inputs = [],
    outputs = a.outputs.explicit [
        {
            summary = a.optional.set "Declarative package and system delivery tool",
            description = a.optional.set "Cast plans, builds, and applies declarative Stone packages.",
            runtime_inputs = [a.dep.binary "cast-container"],
            paths = [a.path.any "*"],
            .. a.output "out"
        },
        {
            summary = a.optional.set "Documentation for cast",
            description = a.optional.set "Documentation files for the cast package",
            paths = [a.path.any "/usr/share/gtk-doc"],
            .. a.output "docs"
        },
        {
            summary = a.optional.set "Development files for cast",
            description = a.optional.set "Install this package if you intend to build software against\nthe cast package.",
            runtime_inputs = [a.dep.output (a.package_ref pname) "out"],
            paths = [
                a.path.any "/usr/include",
                a.path.any "/usr/lib/*.a",
                a.path.any "/usr/lib/cmake",
                a.path.any "/usr/lib/lib*.so",
                a.path.any "/usr/lib/pkgconfig",
                a.path.any "/usr/share/aclocal",
                a.path.any "/usr/share/cmake",
                a.path.any "/usr/share/man/man2",
                a.path.any "/usr/share/man/man3",
                a.path.any "/usr/share/man/man9",
                a.path.any "/usr/share/pkgconfig",
                a.path.any "/usr/share/gir-1.0/*.gir",
                a.path.any "/usr/share/vala/vapi/*.deps",
                a.path.any "/usr/share/vala/vapi/*.vapi",
                a.path.any "/usr/lib/*.prl",
                a.path.any "/usr/lib/metatypes",
                a.path.any "/usr/lib/qt*/metatypes/qt*.json",
                a.path.any "/usr/lib/qt*/mkspecs",
                a.path.any "/usr/lib/qt*/modules/*.json",
                a.path.any "/usr/lib/qt*/sbom",
                a.path.any "/usr/lib/qt*/plugins/designer/*.so",
                a.path.any "/usr/share/doc/qt5/*.qch",
                a.path.any "/usr/share/doc/qt5/*.tags",
                a.path.any "/usr/share/doc/qt6/*.qch",
                a.path.any "/usr/share/doc/qt6/*.tags",
            ],
            .. a.output "devel"
        },
        {
            include_in_manifest = a.false,
            summary = a.optional.set "Debugging symbols for cast",
            description = a.optional.set "Install this package if you need debugging information + symbols\nfor the cast package.",
            paths = [a.path.any "/usr/lib/debug"],
            .. a.output "dbginfo"
        },
        {
            summary = a.optional.set "Library files for cast",
            description = a.optional.set "Library files for cast, typically pulled in as a dependency of another package.",
            .. a.output "libs"
        },
        {
            summary = a.optional.set "Provides 32-bit runtime libraries for cast",
            description = a.optional.set "Install this package if you need the 32-bit versions of the\ncast package libraries.",
            runtime_inputs = [a.dep.output (a.package_ref pname) "out"],
            paths = [a.path.any "/usr/lib32", a.path.any "/usr/lib32/lib*.so.*"],
            .. a.output "32bit"
        },
        {
            summary = a.optional.set "Provides development files for cast-32bit",
            description = a.optional.set "Install this package if you need to build software against\nthe 32-bit version of cast, cast-32bit.",
            runtime_inputs = [
                a.dep.output (a.package_ref pname) "32bit",
                a.dep.output (a.package_ref pname) "devel",
            ],
            paths = [
                a.path.any "/usr/lib32/*.a",
                a.path.any "/usr/lib32/cmake",
                a.path.any "/usr/lib32/lib*.so",
                a.path.any "/usr/lib32/pkgconfig",
            ],
            .. a.output "32bit-devel"
        },
        {
            include_in_manifest = a.false,
            summary = a.optional.set "Debugging symbols for cast-32bit",
            description = a.optional.set "Install this package if you need debugging information + symbols\nfor the cast-32bit package.",
            paths = [a.path.any "/usr/lib32/debug"],
            .. a.output "32bit-dbginfo"
        },
        {
            summary = a.optional.set "Example files for cast",
            description = a.optional.set "Example files for the cast package",
            paths = [a.path.any "/usr/lib/qt*/examples"],
            .. a.output "demos"
        },
    ],
    options = a.unset,
    profiles = [],
    architectures = [],
    tuning = [],
    emul32 = a.false,
    mold = a.false,
    hooks = a.unset,
}
